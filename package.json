{
  "name": "dsh-construction-site",
  "version": "0.3.2",
  "private": false,
  "description": "Construction-site-inspired review workflow for DeepSeek Harness: finance, function audits, and module supervision. / 面向 DeepSeek Harness 的施工现场式质量检查流程。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIRPhoon/dsh-construction-site.git"
  },
  "homepage": "https://github.com/AIRPhoon/dsh-construction-site",
  "bugs": {
    "url": "https://github.com/AIRPhoon/dsh-construction-site/issues"
  },
  "main": "lib/plugin.js",
  "types": "lib/plugin.d.ts",
  "icon": "icon.svg"
}
